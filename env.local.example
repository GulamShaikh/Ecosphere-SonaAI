# Agora credentials
# Required: found in Agora Console → your project → "App ID"
NEXT_PUBLIC_AGORA_APP_ID=

# Required: found in Agora Console → your project → "App Certificate"
# Server-side only. Never expose this in client code.
NEXT_AGORA_APP_CERTIFICATE=

# Optional custom SonaAI intervention engine.
# Set true only when the deployed app is reachable by Agora Cloud.
SONA_INTERVENTION_ENGINE=false
SONA_PUBLIC_BASE_URL=
SONA_LLM_SHARED_SECRET=
SONA_AI_MODE=ASK
NEXT_DEEPGRAM_LANGUAGE=en-US

# Optional wording model used only when the custom intervention engine decides SPEAK.
NEXT_LLM_URL=
NEXT_LLM_API_KEY=
NEXT_LLM_MODEL=gpt-4o-mini
